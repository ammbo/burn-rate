{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "burn-rate",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-07",
  "dev": { "host": "localhost" },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": false },
    "traces": {
      "enabled": false
    }
  },
  "routes": [
    { "pattern": "burnrateagents.com", "custom_domain": true },
    { "pattern": "www.burnrateagents.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  },
  "ai": {
    "binding": "AI"
  },
  "send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["signin@burnrateagents.com"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "burn-rate",
      "database_id": "acba24e4-7207-4b00-a3a0-043c140694e3"
    }
  ],
  "vars": {
    "PAYPAL_MODE": "sandbox",
    "EMAIL_FROM": "signin@burnrateagents.com",
    "APP_ORIGIN": "https://burnrateagents.com",
    "GENERATION_ENABLED": "true",
    "GENERATION_DAILY_LIMIT": "20",
    "GENERATION_TOTAL_LIMIT": "50",
    "GENERATION_ACCOUNT_LIMIT": "3",
    "GENERATION_IP_LIMIT": "6"
  },
  "triggers": { "crons": ["17 5 * * *"] }
}
